    {
      "parameters": {
        "jsCode": "\nfunction cleanPhone(raw) {\n  var p = String(raw || '').replace(/[^0-9]/g, '');\n  if (p === '') { return ''; }\n  if (p.length === 11 && p.charAt(0) === '0') { return '91' + p.substring(1); }\n  if (p.length === 10 && '6789'.indexOf(p.charAt(0)) !== -1) { return '91' + p; }\n  if (p.length === 12 && p.substring(0, 2) === '91') { return p; }\n  if (p.length >= 11 && p.length <= 15) { return p; }\n  return '91' + p;\n}\n\nvar hook = $('Agent Reply Webhook').first().json;\nvar body = hook.body || hook;\nvar who = ($('Verify Staff').first().json || {}).body || {};\nvar phone = cleanPhone(body.phone);\nvar message = String(body.message || '').trim();\nvar agent = String(body.agent_name || who.email || 'Staff').trim();\n\nif (phone === '' || message === '') {\n  return [{ json: { error: true, reason: 'Missing phone or message' } }];\n}\nif (message.length > 4000) {\n  return [{ json: { error: true, reason: 'Message exceeds WhatsApp 4096 char limit' } }];\n}\nreturn [{ json: { phone: phone, message: message, agent_name: agent, error: false } }];\n"
      },
