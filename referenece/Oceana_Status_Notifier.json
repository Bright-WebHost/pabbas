    {
      "parameters": {
        "jsCode": "\nvar hook = $('Status Webhook').first().json;\nvar d = hook.body || hook;\nvar who = ($('Verify Staff').first().json || {}).body || {};\nvar allowed = ['new','preparing','ready_for_pickup','out_for_delivery','delivered','cancelled'];\nvar status = String(d.status || '').trim();\nvar orderNum = String(d.order_number || '').trim();\n// older dashboards still send 'confirmed' - that step no longer exists\nif (status === 'confirmed') { status = 'preparing'; }\nif (orderNum === '' || allowed.indexOf(status) === -1) {\n  return [{ json: { error: true, reason: 'Invalid order_number or status' } }];\n}\nreturn [{ json: { order_number: orderNum, status: status,\n                  staff: String(d.agent_name || who.email || 'staff'), error: false } }];\n"
      },
      "id": "oceana-status-notifier-extract-data",
      "name": "Extract Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
