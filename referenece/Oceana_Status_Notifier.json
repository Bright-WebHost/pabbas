      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nvar rows = $input.first().json;\nvar order = Array.isArray(rows) ? (rows[0] || null) : (rows || null);\nif (order && typeof order === 'object' && Object.keys(order).length === 0) { order = null; }\nif (!order || !order.customer_phone) { return [{ json: { skip: true } }]; }\n\nvar name = order.customer_name ? (' ' + String(order.customer_name).split(' ')[0]) : '';\nvar num = order.order_number || '';\nvar status = $('Extract Data').first().json.status;\n\nvar messages = {\n  preparing: 'Hi' + name + ', your Oceana Hotel order *' + num + '* has been accepted and our kitchen is preparing it now.',\n  out_for_delivery: 'Good news' + name + '! Your order *' + num + '* is on its way. Expect it in 20-35 minutes.',\n  ready_for_pickup: 'Hi' + name + ', your order *' + num + '* is ready for pickup at Janapriya Complex, State Bank, Mangalore.',\n  delivered: 'Delivered! Hope you enjoy your meal' + name + '.\\n\\nHow was it? Reply with a number from 1 to 5.\\n(1 = poor, 5 = excellent)',\n  cancelled: 'Hi' + name + ', your order *' + num + '* has been cancelled by the restaurant.\\nPlease call +91 96634 28354 if this is unexpected.'\n};\n\nvar msg = messages[status];\nif (!msg) { return [{ json: { skip: true } }]; }\n\nreturn [{ json: { skip: false, phone: String(order.customer_phone),\n                  message: msg, order_number: num, status: status } }];\n"
      },
