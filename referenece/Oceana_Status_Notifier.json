        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.status === \"cancelled\" ? { status: $json.status, cancelled_by: \"staff:\" + $json.staff, cancelled_at: new Date().toISOString() } : { status: $json.status }) }}",
        "sendHeaders": true,
        "headerParameters": {
