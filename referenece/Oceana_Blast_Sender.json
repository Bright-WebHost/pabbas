    {
      "parameters": {
        "jsCode": "\nvar hook = $('Blast Webhook').first().json;\nvar body = hook.body || hook;\n// An explicit list from the dashboard wins over the saved-contacts filter.\nvar phones = Array.isArray(body.phones) ? body.phones : [];\n\nreturn [{ json: {\n  phones: phones,\n  filter: body.filter || 'all',                       // all | active_30 | repeat\n  template_name: body.template_name || 'oceana_promo_en',\n  language: body.language || 'en',\n  header_image: body.header_image || '',   // filled from settings if blank\n  run_started_at: new Date().toISOString(),\n  run_id: 'blast_' + Date.now()\n} }];\n"
      },
      "id": "oceana-blast-sender-extract-params",
      "name": "Extract Params",
      "type": "n8n-nodes-base.code",
