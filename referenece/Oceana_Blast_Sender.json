      "parameters": {
        "jsCode": "\nvar raw = $input.all().map(function (i) { return i.json; });\nvar rows = [];\nraw.forEach(function (r) {\n  if (Array.isArray(r)) { rows = rows.concat(r); }\n  else if (r && r.phone && r.status) { rows.push(r); }\n});\n\nvar sent = 0, failed = 0, firstError = '';\nrows.forEach(function (r) {\n  if (r.status === 'sent') { sent += 1; }\n  else { failed += 1; if (!firstError && r.error) { firstError = r.error; } }\n});\n\nvar attempted = sent + failed;\nvar skippedSelf = 0;\ntry { skippedSelf = $('Extract Params').first().json.skipped_self || 0; } catch (e) {}\n\nreturn [{ json: { success: true, attempted: attempted, sent: sent, failed: failed,\n  error: firstError, skipped_self: skippedSelf,\n  run_id: $('Extract Params').first().json.run_id } }];\n"
      },
