        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "\nfunction cleanPhone(raw) {\n  var p = String(raw || '').replace(/[^0-9]/g, '');\n  if (p === '') { return ''; }\n  if (p.length === 11 && p.charAt(0) === '0') { return '91' + p.substring(1); }\n  if (p.length === 10 && '6789'.indexOf(p.charAt(0)) !== -1) { return '91' + p; }\n  if (p.length === 12 && p.substring(0, 2) === '91') { return p; }\n  if (p.length >= 11 && p.length <= 15) { return p; }\n  return '91' + p;\n}\n\nvar params = $('Extract Params').first().json;\n// The approved template carries an image header, so every send MUST include the\n// image parameter or Meta rejects it with a parameter-count error.\nvar hdr = params.header_image;\nif (!hdr) {\n  try { hdr = ($('Get Header Image').all().map(function(i){return i.json;})\n               .filter(function(r){return r && r.value;})[0] || {}).value || ''; } catch (e) { hdr = ''; }\n}\nvar raw = $input.all().map(function (i) { return i.json; });\nvar all = [];\nraw.forEach(function (r) { if (Array.isArray(r)) { all = all.concat(r); } else if (r && r.phone) { all.push(r); } });\n\n// If the dashboard sent a specific list, use exactly that and skip the filters.\nif (params.phones && params.phones.length) {\n  all = params.phones.map(function (p) { return { phone: p, name: '' }; });\n}\n\nvar cutoff = new Date(Date.now() - (30 * 24 * 60 * 60 * 1000));\nvar list = all.filter(function (c) { return c.phone && String(c.phone).trim() !== ''; });\n\nif (!params.phones.length && params.filter === 'active_30') {\n  list = list.filter(function (c) {\n    return c.last_order_date && (new Date(c.last_order_date) >= cutoff);\n  });\n} else if (!params.phones.length && params.filter === 'repeat') {\n  list = list.filter(function (c) { return Number(c.total_orders || 0) > 1; });\n}\n\n// The business's own number can never receive its own template - Meta rejects it\n// with (#100) Invalid parameter. Drop it before it wastes a send.\nvar SELF = '919663428354';\n\n// Deduplicate on the cleaned number so nobody is messaged twice in one blast\nvar seen = {};\nvar out = [];\nfor (var i = 0; i < list.length; i++) {\n  var p = cleanPhone(list[i].phone);\n  if (p === '' || p === SELF || seen[p]) { continue; }\n  seen[p] = true;\n  out.push({ json: { phone: p, name: list[i].name || '',\n                     template: params.template_name, run_id: params.run_id, language: params.language,\n                     header_image: hdr } });\n}\nif (out.length === 0) { return [{ json: { phone: '', empty: true } }]; }\nreturn out;\n"
      },
