    {
      "parameters": {
        "jsCode": "\nvar res = $input.first().json;\nvar cust = $('Loop Over Customers').first().json;\n\nvar messageId = '';\ntry { messageId = res.messages[0].id || ''; } catch (e) { messageId = ''; }\nvar errorMsg = '';\ntry { errorMsg = res.error.message || ''; } catch (e) { errorMsg = ''; }\n\nvar failed = (messageId === '');\nvar httpErr = '';\ntry { httpErr = res.error && res.error.message ? res.error.message : ''; } catch (e) {}\nif (!errorMsg && httpErr) { errorMsg = httpErr; }\n\nreturn [{ json: {\n  run_id: cust.run_id,\n  phone: cust.phone,\n  blast_message_id: messageId,\n  blast_status: failed ? 'failed' : 'sent',\n  blast_sent_at: failed ? null : new Date().toISOString(),\n  blast_error: errorMsg\n} }];\n"
      },
