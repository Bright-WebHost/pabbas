        "method": "GET",
        "url": "https://mvyeccwomwsgtzuxddye.supabase.co/rest/v1/customers",
        "authentication": "genericCredentialType",
        "options": {
          "timeout": 10000
        },
        "sendQuery": true,
        "queryParameters": {
