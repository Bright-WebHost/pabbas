      "parameters": {
        "jsCode": "\nfunction cleanPhone(raw) {\n  var p = String(raw || '').replace(/[^0-9]/g, '');\n  if (p === '') { return ''; }\n  if (p.length === 11 && p.charAt(0) === '0') { return '91' + p.substring(1); }\n  if (p.length === 10 && '6789'.indexOf(p.charAt(0)) !== -1) { return '91' + p; }\n  if (p.length === 12 && p.substring(0, 2) === '91') { return p; }\n  if (p.length >= 11 && p.length <= 15) { return p; }\n  return '91' + p;\n}\n\nvar hook = $('Toggle Webhook').first().json;\nvar body = hook.body || hook;\nvar who = ($('Verify Staff').first().json || {}).body || {};\nvar phone = cleanPhone(body.phone);\nvar enabled = (body.enabled === true || body.enabled === 'true');\nvar agent = String(body.agent_name || who.email || 'Staff').trim();\nif (phone === '') { return [{ json: { error: true, reason: 'Missing phone' } }]; }\nreturn [{ json: { phone: phone, enabled: enabled, agent_name: agent, error: false } }];\n"
      },
