    {
      "parameters": {
        "jsCode": "\nvar o = $input.first().json;\nif (!o || !o.customer_phone) { return [{ json: { skip: true } }]; }\nvar name = o.customer_name ? (' ' + String(o.customer_name).split(' ')[0]) : '';\nvar msg = 'Hope you enjoyed your meal' + name + '!\\n\\n' +\n  'How was order ' + o.order_number + '? Tap a rating below, or reply with a number from 1 to 5.';\nreturn [{ json: { skip: false, phone: o.customer_phone, order_number: o.order_number,\n  outgoing: { type: 'interactive', interactive: { type: 'button',\n    body: { text: msg },\n    action: { buttons: [\n      { type: 'reply', reply: { id: 'rate_5', title: '5 - Excellent' } },\n      { type: 'reply', reply: { id: 'rate_4', title: '4 - Good' } },\n      { type: 'reply', reply: { id: 'rate_3', title: '3 - Okay' } } ] } } } } }];\n"
      },
      "id": "oceana-rating-request-build-ask",
      "name": "Build Ask",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/1057952097409620/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ messaging_product: \"whatsapp\", recipient_type: \"individual\", to: $json.phone }, $json.outgoing)) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "oceana-rating-request-send-ask",
