        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ messaging_product: \"whatsapp\", recipient_type: \"individual\", to: $json.phone }, $json.outgoing)) }}",
        "options": {
