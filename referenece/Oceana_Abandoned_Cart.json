    {
      "parameters": {
        "jsCode": "\nfunction rs(n){ return 'Rs ' + Number(n||0).toLocaleString('en-IN'); }\nvar c = $input.first().json;\nif (!c || !c.phone) { return [{ json: { skip: true } }]; }\nvar items = Array.isArray(c.items) ? c.items : [];\nvar names = items.slice(0, 3).map(function (i) { return i.name; }).join(', ');\nvar more = items.length > 3 ? (' and ' + (items.length - 3) + ' more') : '';\nvar msg = 'You left ' + (names || 'a few items') + more + ' in your cart (' + rs(c.total) + ').\\n\\n' +\n  'Still hungry? Tap below and we will get it moving.';\nreturn [{ json: { skip: false, phone: c.phone, outgoing: { type: 'interactive', interactive: {\n  type: 'cta_url', body: { text: msg },\n  action: { name: 'cta_url', parameters: { display_text: 'Finish Order',\n    url: 'https://oceanamenunew.netlify.app?ph=' + c.phone } } } } } }];\n"
      },
      "id": "oceana-abandoned-cart-build-nudge",
      "name": "Build Nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
