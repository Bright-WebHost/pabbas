{
  "name": "Pabbas | Staff | AI Toggle",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pabbas-ai-toggle",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "pabbas-ai-toggle-webhook",
      "name": "Toggle Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        220
      ],
      "webhookId": "pabbas-ai-toggle",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Pabbas_WhatsApp_Inbound_Secret_ID",
          "name": "Pabbas WhatsApp Inbound Secret"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "JavaScript",
        "jsCode": "const hook = $input.first().json; const body = hook.body || hook; const who = $('Verify Staff').first().json || {}; const cleanPhone = (raw) => { const p = String(raw || '').replace(/[^0-9]/g, ''); if (p === '') return ''; if (p.length === 11 && p.charAt(0) === '0') return '91' + p.substring(1); if (p.length === 10 && '6789'.indexOf(p.charAt(0)) !== -1) return '91' + p; if (p.length === 12 && p.substring(0, 2) === '91') return p; if (p.length >= 11 && p.length <= 15) return p; return '91' + p; }; const phone = cleanPhone(body.phone); const enabled = body.enabled === true || body.enabled === 'true'; const agent = String(body.agent_name || who.body?.email || 'Staff').trim(); if (phone === '') return [{ json: { error: true, reason: 'Missing phone' } }]; return [{ json: { phone, enabled, agent_name: agent, error: false } }];"
      },
      "id": "pabbas-ai-toggle-parse",
      "name": "Parse Toggle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        430,
        220
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.error }}",
              "operation": "false"
            }
          ]
        }
      },
      "id": "pabbas-ai-toggle-valid",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        650,
        220
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/rpc/staff_check",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY || 'YOUR_SERVICE_ROLE_KEY' }}"
            },
            {
              "name": "Authorization",
              "value": "={{ $json.headers?.authorization || 'Bearer ' + ($env.SUPABASE_SERVICE_ROLE_KEY || 'YOUR_SERVICE_ROLE_KEY') }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "pabbas-ai-toggle-verify-staff",
      "name": "Verify Staff",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        20
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/chat_sessions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "on_conflict",
              "value": "phone"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "resolution=merge-duplicates,return=representation"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.phone, ai_enabled: $json.enabled, ai_disabled_at: $json.enabled ? null : new Date().toISOString(), ai_disabled_by: $json.enabled ? '' : $json.agent_name, last_human_activity_at: new Date().toISOString() }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "pabbas-ai-toggle-upsert-session",
      "name": "Upsert Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        870,
        120
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, phone: $('Parse Toggle').first().json.phone, ai_enabled: $('Parse Toggle').first().json.enabled }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "pabbas-ai-toggle-respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1090,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ JSON.stringify({ success: false, error: $json.reason }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "pabbas-ai-toggle-respond-err",
      "name": "Respond Err",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        870,
        340
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "pabbas-ai-toggle-is-staff-check",
              "leftValue": "={{ $json.statusCode === 200 && !!$json.body && $json.body.staff === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "pabbas-ai-toggle-is-staff",
      "name": "Is Staff?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
