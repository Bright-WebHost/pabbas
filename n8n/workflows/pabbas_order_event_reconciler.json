{
  "name": "Pabbas | Orders | Event Reconciler",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/rpc/poll_order_events",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_limit",
              "value": 50
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Poll Order Events",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 300],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {},
      "id": "3",
      "name": "Loop",
      "type": "n8n-nodes-base.loop",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_ORDER_WEBHOOK_URL || 'https://webhost.app.n8n.cloud/webhook/pabbas-order-event' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "event_id",
              "value": "={{ $json.event_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Invoke Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "Pabbas_Webhook_Secret_ID",
          "name": "Pabbas Webhook Secret"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Poll Order Events",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll Order Events": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop": {
      "main": [
        [],
        [
          {
            "node": "Invoke Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Invoke Webhook": {
      "main": [
        [
          {
            "node": "Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}
