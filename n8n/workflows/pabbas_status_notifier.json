{
  "name": "Pabbas | Status Notifier",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pabbas-status",
        "responseMode": "onReceived",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
            ]
          }
        }
      },
      "id": "pabbas-status-webhook",
      "name": "Status Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        200
      ],
      "webhookId": "pabbas-status",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Pabbas_WhatsApp_Inbound_Secret_ID",
          "name": "Pabbas WhatsApp Inbound Secret"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "JavaScript",
        "jsCode": "const hook = $input.first().json; const d = hook.body || hook; const who = $('Verify Staff').first().json || {}; const allowed = ['new', 'preparing', 'ready_for_pickup', 'out_for_delivery', 'delivered', 'cancelled']; let status = String(d.status || '').trim(); const orderNum = String(d.order_number || '').trim(); if (status === 'confirmed') status = 'preparing'; if (orderNum === '' || allowed.indexOf(status) === -1) return [{ json: { error: true, reason: 'Invalid order_number or status' } }]; return [{ json: { order_number: orderNum, status, staff: String(d.agent_name || who.body?.email || 'staff'), error: false } }];"
      },
      "id": "pabbas-status-extract-data",
      "name": "Extract Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        430,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.error }}",
              "operation": "false"
            }
          ]
        }
      },
      "id": "pabbas-status-valid-status",
      "name": "Valid Status?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/orders",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "order_number",
              "value": "=eq.{{ $json.order_number }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.status === 'cancelled' ? { status: $json.status, cancelled_by: 'staff:' + $json.staff, cancelled_at: new Date().toISOString() } : { status: $json.status }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "pabbas-status-update-status",
      "name": "Update Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        870,
        120
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "JavaScript",
        "jsCode": "const rows = $input.first().json; const order = Array.isArray(rows) ? (rows[0] || null) : (rows || null); if (order && typeof order === 'object' && Object.keys(order).length === 0) return [{ json: { skip: true } }]; if (!order || !order.customer_phone) return [{ json: { skip: true } }]; const name = order.customer_name ? ' ' + String(order.customer_name).split(' ')[0] : ''; const num = order.order_number || ''; const status = $('Extract Data').first().json.status; const messages = { preparing: 'Hi' + name + ', your Pabbas order *' + num + '* has been accepted and our kitchen is preparing it now.', out_for_delivery: 'Good news' + name + '! Your order *' + num + '* is on its way. Expect it in 20-35 minutes.', ready_for_pickup: 'Hi' + name + ', your order *' + num + '* is ready for pickup.', delivered: 'Delivered! Hope you enjoy your meal' + name + '.\n\nHow was it? Reply with a number from 1 to 5.\n(1 = poor, 5 = excellent)', cancelled: 'Hi' + name + ', your order *' + num + '* has been cancelled by the restaurant.' }; const msg = messages[status]; if (!msg) return [{ json: { skip: true } }]; return [{ json: { skip: false, phone: String(order.customer_phone), message: msg, order_number: num, status } }];"
      },
      "id": "pabbas-status-build-message",
      "name": "Build Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1090,
        120
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.skip }}",
              "operation": "false"
            }
          ]
        }
      },
      "id": "pabbas-status-should-notify",
      "name": "Should Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1310,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ycloud.com/whatsapp/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $json.phone, text: { body: $json.message } }) }}",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "pabbas-status-send-whatsapp",
      "name": "Send WhatsApp (TODO: verify YCloud payload)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1530,
        40
      ],
      "disabled": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "Pabbas_YCloud_WhatsApp_Token_ID",
          "name": "Pabbas YCloud WhatsApp Token"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $('Build Message').first().json.phone, direction: 'outbound', sender: 'system', message_type: 'text', content: $('Build Message').first().json.message }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "pabbas-status-log-message",
      "name": "Log Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1530,
        220
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, order_number: $('Extract Data').first().json.order_number, status: $('Extract Data').first().json.status }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Access-Control-Allow-Origin",
                "value": "*"
              }
