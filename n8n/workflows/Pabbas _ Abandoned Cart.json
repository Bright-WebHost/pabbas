    {
      "parameters": {
        "jsCode": "const session = $input.first().json;\nconst cart = $('Loop Carts').item.json;\n\nconst ctaUrl = session.cta_url;\n\nif (!ctaUrl || !cart.phone) {\n  return [{\n    json: {\n      ...cart,\n      skip: true\n    }\n  }];\n}\n\nconst rs = (n) => 'Rs ' + Number(n || 0).toLocaleString('en-IN');\n\nconst items = Array.isArray(cart.items) ? cart.items : [];\n\nconst names = items\n  .slice(0, 3)\n  .map((i) => i.name)\n  .filter(Boolean)\n  .join(', ');\n\nconst more = items.length > 3\n  ? ' and ' + (items.length - 3) + ' more'\n  : '';\n\nconst message =\n  'You left ' +\n  (names || 'a few items') +\n  more +\n  ' in your cart (' +\n  rs(cart.total) +\n  ').\\n\\nStill hungry? Tap below and we will get it moving.';\n\nreturn [{\n  json: {\n    ...cart,\n    skip: false,\n    phone: cart.phone,\n    cta_url: ctaUrl,\n\n    outgoing: {\n      type: 'interactive',\n      interactive: {\n        type: 'cta_url',\n        body: {\n          text: message\n        },\n        action: {\n          name: 'cta_url',\n          parameters: {\n            display_text: 'Finish Order',\n            url: ctaUrl\n          }\n        }\n      }\n    }\n  }\n}];"
      },
