    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (items.length === 0 || !items[0].json?.id || !items[0].json?.channel_user_id) {\n  return [{\n    json: {\n      identity_valid: false\n    }\n  }];\n}\n\nconst customer = items[0].json;\n\n// Preserve the original abandoned-cart data from Loop Carts\nconst cart = $('Loop Carts').item.json;\n\nreturn [{\n  json: {\n    ...cart,\n    identity_valid: true,\n    customer_id: customer.id,\n    channel_user_id: customer.channel_user_id,\n    customer_phone: customer.phone,\n    customer_name: customer.name\n  }\n}];"
      },
      "id": "b85b49ce-3f28-414a-85a9-1730af1b403c",
      "name": "Validate Customer Identity",
      "type": "n8n-nodes-base.code",
