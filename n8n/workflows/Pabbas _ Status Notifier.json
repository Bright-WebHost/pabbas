    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst body = item.json.body || item.json;\n\nconst order_number = body.order_number || '';\nconst customer_phone = body.customer_phone || '';\nconst customer_name = body.customer_name || 'Valued Customer';\nconst order_type = body.order_type || 'delivery';\nconst items = body.items || [];\nconst total = body.total || 0;\n\nreturn [{\n  json: {\n    order_number,\n    customer_phone,\n    customer_name,\n    order_type,\n    items,\n    total\n  }\n}];"
      },
      "id": "b2c3d4e5-f6a7-8901-bcde-f12345678901",
      "name": "Extract Order Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        256,
        608
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst o = item.json;\n\nlet itemLines = '';\nif (Array.isArray(o.items) && o.items.length > 0) {\n  itemLines = o.items\n    .map(i => `\u2022 ${i.item_name} x${i.quantity}`)\n    .join('\\n');\n} else {\n  itemLines = '\u2022 (see order details)';\n}\n\nconst typeLabel = o.order_type === 'dine-in' ? 'Dine-in' :\n                  o.order_type === 'takeaway' ? 'Takeaway' : 'Delivery';\n\nconst msg = `Hi ${o.customer_name}! \ud83d\udc4b\n\nWe've received your Pabbas ${typeLabel} order #${o.order_number}.\n\nYour order:\n${itemLines}\n\nTotal: \u20b9${o.total}\n\nWe'll keep you updated here on WhatsApp. Thank you!`;\n\nreturn [{\n  json: {\n    phone: o.customer_phone,\n    message: msg,\n    skip: !o.customer_phone\n  }\n}];"
      },
