    {
      "parameters": {
        "language": "JavaScript",
        "jsCode": "for (const item of $input.all()) {\n  const order = item.json;\n  let msg = \"\";\n  let skip = false;\n  \n  if (Array.isArray(order) && order.length > 0) {\n      // Sometimes Supabase returns an array for updates\n      Object.assign(order, order[0]);\n  }\n  \n  switch(order.status) {\n    case 'preparing':\n      msg = `Hi ${order.customer_name || 'there'}, your order #${order.order_number} is now being prepared!`;\n      break;\n    case 'ready_for_pickup':\n      msg = `Hi ${order.customer_name || 'there'}, your order #${order.order_number} is ready for pickup!`;\n      break;\n    case 'out_for_delivery':\n      msg = `Hi ${order.customer_name || 'there'}, your order #${order.order_number} is out for delivery!`;\n      break;\n    case 'delivered':\n      msg = `Hi ${order.customer_name || 'there'}, your order #${order.order_number} has been delivered. Enjoy!`;\n      break;\n    case 'cancelled':\n      msg = `Hi ${order.customer_name || 'there'}, your order #${order.order_number} has been cancelled.`;\n      break;\n    default:\n      skip = true;\n  }\n  \n  item.json.phone = order.customer_phone;\n  item.json.message = msg;\n  item.json.skip = skip;\n}\nreturn $input.all();"
      },
