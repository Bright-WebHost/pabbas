      "id": "9d70254d-acef-4db6-b7db-02435e763b7e",
      "name": "Loop Orders",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -272,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const o = $input.first().json;\n\nif (!o || !o.customer_phone) {\n  return [{ json: { skip: true } }];\n}\n\nconst name = o.customer_name\n  ? ' ' + String(o.customer_name).split(' ')[0]\n  : '';\n\nconst msg =\n  'Hope you enjoyed your meal' +\n  name +\n  '!\\n\\nHow was order ' +\n  o.order_number +\n  '? Tap a rating below, or reply with a number from 1 to 5.';\n\nreturn [{\n  json: {\n    skip: false,\n    phone: o.customer_phone,\n    order_number: o.order_number,\n    outgoing: {\n      type: 'interactive',\n      interactive: {\n        type: 'button',\n        body: {\n          text: msg\n        },\n        action: {\n          buttons: [\n            {\n              type: 'reply',\n              reply: {\n                id: 'rate_5',\n                title: '5 - Excellent'\n              }\n            },\n            {\n              type: 'reply',\n              reply: {\n                id: 'rate_4',\n                title: '4 - Good'\n              }\n            },\n            {\n              type: 'reply',\n              reply: {\n                id: 'rate_3',\n                title: '3 - Okay'\n              }\n            }\n          ]\n        }\n      }\n    }\n  }\n}];"
      },
      "id": "312d48c1-0327-4022-ae61-7c22f6921dc3",
      "name": "Build Ask",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ycloud.com/whatsapp/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ to: $json.phone }, $json.outgoing)) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "59a1840e-2245-4fca-8c80-428fa426fdeb",
      "name": "Send Ask (TODO: verify YCloud payload)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        192
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "x4SuAc2J4iQHp2E0",
          "name": "x-pabbas-whatsapp-secret"
        }
      },
      "disabled": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://clqzctntkwzahdfjeqlx.supabase.co' }}/rest/v1/reviews",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
