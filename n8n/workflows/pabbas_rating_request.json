{
  "name": "Pabbas | Rating Request",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "pabbas-rating-request-every-10-minutes",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/pending_ratings",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "*"
            },
            {
              "name": "limit",
              "value": "20"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "pabbas-rating-request-find-delivered",
      "name": "Find Delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        430,
        200
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "pabbas-rating-request-loop-orders",
      "name": "Loop Orders",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "JavaScript",
        "jsCode": "const o = $input.first().json; if (!o || !o.customer_phone) return [{ json: { skip: true } }]; const name = o.customer_name ? ' ' + String(o.customer_name).split(' ')[0] : ''; const msg = 'Hope you enjoyed your meal' + name + '!\n\nHow was order ' + o.order_number + '? Tap a rating below, or reply with a number from 1 to 5.'; return [{ json: { skip: false, phone: o.customer_phone, order_number: o.order_number, outgoing: { type: 'interactive', interactive: { type: 'button', body: { text: msg }, action: { buttons: [ { type: 'reply', reply: { id: 'rate_5', title: '5 - Excellent' } }, { type: 'reply', reply: { id: 'rate_4', title: '4 - Good' } }, { type: 'reply', reply: { id: 'rate_3', title: '3 - Okay' } } ] } } } } }];"
      },
      "id": "pabbas-rating-request-build-ask",
      "name": "Build Ask",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        870,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ycloud.com/whatsapp/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ to: $json.phone }, $json.outgoing)) }}",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "pabbas-rating-request-send-ask",
      "name": "Send Ask (TODO: verify YCloud payload)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1090,
        120
      ],
      "disabled": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "Pabbas_YCloud_WhatsApp_Token_ID",
          "name": "Pabbas YCloud WhatsApp Token"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/reviews",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ order_number: $('Build Ask').first().json.order_number, phone: $('Build Ask').first().json.phone, asked_at: new Date().toISOString() }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "pabbas-rating-request-reserve-review",
      "name": "Reserve Review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1310,
        120
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "amount": 2,
        "unit": "seconds"
      },
      "id": "pabbas-rating-request-wait-2s",
      "name": "Wait 2s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1530,
        120
      ],
      "webhookId": "pabbas-rate-wait"
    },
    {
      "parameters": {},
      "id": "pabbas-rating-request-done",
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        870,
        -60
      ]
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "tags": [],
  "id": "",
  "meta": {},
  "connections": {
    "Every 10 Minutes": {
      "main": [
        [
          {
            "node": "Find Delivered",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Delivered": {
      "main": [
        [
          {
            "node": "Loop Orders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Orders": {
      "main": [
        [
          {
            "node": "Build Ask",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Ask": {
      "main": [
        [
          {
            "node": "Send Ask (TODO: verify YCloud payload)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Ask (TODO: verify YCloud payload)": {
      "main": [
        [
          {
            "node": "Reserve Review",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reserve Review": {
      "main": [
        [
          {
            "node": "Wait 2s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 2s": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
