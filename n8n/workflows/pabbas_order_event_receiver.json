{
  "name": "Pabbas | Orders | Event Receiver",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pabbas-order-event",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "pabbas-order-event-receiver",
      "credentials": {
        "httpHeaderAuth": {
          "id": "Pabbas_Webhook_Secret_ID",
          "name": "Pabbas Webhook Secret"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/rpc/claim_order_event",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_event_id",
              "value": "={{ $json.body.event_id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Claim Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        450,
        300
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equal",
              "value2": "processing"
            }
          ]
        }
      },
      "id": "3",
      "name": "IF Claim Successful?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {},
      "id": "4",
      "name": "Stop (Unclaimed)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        850,
        450
      ]
    },
    {
      "parameters": {
        "keepOnlySet": false,
        "values": {
          "boolean": [
            {
              "name": "simulate_failure",
              "value": false
            }
          ]
        },
        "options": {}
      },
      "id": "5",
      "name": "Test Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        850,
        150
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst payload = item.payload;\n\nif (item.simulate_failure === true) {\n  throw new Error(\"Simulated mock failure triggered by test flag.\");\n}\n\nconst order = payload.order;\nconst fulfillment = payload.fulfillment;\nconst pricing = payload.pricing;\nconst items = payload.items;\nconst customer = payload.customer;\n\nlet message = `Hi ${customer.name},\\n`;\nmessage += `Your Pabbas order ${order.order_number} is confirmed! ✅\\n\\n`;\n\nmessage += `Type: ${order.order_type.toUpperCase()}\\n`;\nif (order.order_type === 'delivery' && fulfillment.delivery_address) {\n  message += `Delivery Address: ${fulfillment.delivery_address}\\n`;\n} else if (order.order_type === 'dine-in' && fulfillment.table_number) {\n  message += `Table: ${fulfillment.table_number} (Party of ${fulfillment.party_size})\\n`;\n}\nif (order.scheduled_time) {\n  message += `Scheduled: ${order.scheduled_time}\\n`;\n} else {\n  message += `Time: ASAP\\n`;\n}\n\nmessage += `\\nItems:\\n`;\nitems.forEach(i => {\n  let line = `${i.quantity}x ${i.name}`;\n  if (i.variant_name) line += ` (${i.variant_name})`;\n  line += ` - ₹${(i.line_total_paise / 100).toFixed(2)}`;\n  message += line + `\\n`;\n});\n\nmessage += `\\nTotal: ₹${(pricing.total_paise / 100).toFixed(2)}\\n`;\nmessage += `Payment: ${order.payment_method.toUpperCase()} (${order.payment_status})\\n\\n`;\nmessage += `Thank you for choosing Pabbas!`;\n\nreturn [\n  {\n    json: {\n      mock_sent: true,\n      channel: \"whatsapp-simulator\",\n      message: message\n    }\n  }\n];"
      },
      "id": "6",
      "name": "Mock WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        150
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.error ? 'error' : 'success' }}",
              "operation": "equal",
              "value2": "success"
            }
          ]
        }
      },
      "id": "7",
      "name": "IF Mock Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1250,
        150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/rpc/complete_order_event",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_event_id",
              "value": "={{ $('Claim Event').item.json.id }}"
            }
          ]
        },
        "options": {}
      },
      "id": "8",
      "name": "Complete Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1650,
        -150
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/rpc/fail_order_event",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "p_event_id",
              "value": "={{ $('Claim Event').item.json.id }}"
            },
            {
              "name": "p_error",
              "value": "={{ $json.error.message || 'Mock processing failed' }}"
            }
          ]
        },
        "options": {}
      },
      "id": "9",
      "name": "Fail Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1450,
        250
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/dev_whatsapp_messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "customer_id",
              "value": "={{ $('Claim Event').item.json.payload.customer.id }}"
            },
            {
              "name": "message",
              "value": "={{ $('Mock WhatsApp Message').item.json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "10",
      "name": "Send to Simulator",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        1450,
        -150
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Claim Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Event": {
      "main": [
        [
          {
            "node": "IF Claim Successful?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Claim Successful?": {
      "main": [
        [
          {
            "node": "Test Config",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stop (Unclaimed)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Test Config": {
      "main": [
        [
          {
            "node": "Mock WhatsApp Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mock WhatsApp Message": {
      "main": [
        [
          {
            "node": "IF Mock Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF Mock Success?": {
      "main": [
        [
          {
            "node": "Send to Simulator",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fail Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send to Simulator": {
      "main": [
        [
          {
            "node": "Complete Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  }
}