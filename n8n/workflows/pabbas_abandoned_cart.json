{
  "name": "Pabbas | Abandoned Cart",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "pabbas-abandoned-cart-every-10-minutes",
      "name": "Every 10 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        200,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/abandoned_carts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "*"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "pabbas-abandoned-cart-find-abandoned",
      "name": "Find Abandoned",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        430,
        200
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "pabbas-abandoned-cart-loop-carts",
      "name": "Loop Carts",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        650,
        200
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/app_customers",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "channel",
              "value": "=eq.whatsapp"
            },
            {
              "name": "phone",
              "value": "=eq.{{ $json.phone }}"
            },
            {
              "name": "select",
              "value": "id,channel_user_id,phone,name"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "pabbas-abandoned-cart-resolve-customer-identity",
      "name": "Resolve Customer Identity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        870,
        200
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "alwaysOutputData": true,
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "JavaScript",
        "jsCode": "const cart = $input.first().json || {}; const rows = $input.all().flatMap((item) => Array.isArray(item.json) ? item.json : [item.json]).filter(Boolean); const customerRows = rows.filter((row) => row && (row.id || row.channel_user_id || row.phone)); const phone = cart.phone || rows[0]?.phone || ''; if (!phone) return [{ json: { skip: true, reason: 'missing_cart_phone', cart } }]; if (customerRows.length === 0) return [{ json: { skip: true, reason: 'customer_identity_not_found', phone, cart } }]; if (customerRows.length > 1) return [{ json: { skip: true, reason: 'ambiguous_customer_identity', phone, matches: customerRows.slice(0, 5), cart } }]; const customer = customerRows[0]; return [{ json: { skip: false, phone, cart, customer_id: customer.id, channel_user_id: customer.channel_user_id, customer_phone: customer.phone || phone, customer_name: customer.name || 'WhatsApp Customer' } }];"
      },
      "id": "pabbas-abandoned-cart-validate-customer-identity",
      "name": "Validate Customer Identity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1090,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.skip }}",
              "operation": "false"
            }
          ]
        }
      },
      "id": "pabbas-abandoned-cart-customer-identity-valid",
      "name": "Customer Identity Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1310,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "JavaScript",
        "jsCode": "return $input.all();"
      },
      "id": "pabbas-abandoned-cart-skip-invalid-identity",
      "name": "Skip Invalid Identity",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1310,
        420
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://pabbas-one.vercel.app/api/ai/tools/customer/lookup",
        "authentication": "none",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $json.phone }}"
            },
            {
              "name": "channel_user_id",
              "value": "={{ $json.channel_user_id }}"
            },
            {
              "name": "name",
              "value": "={{ $json.customer_name || 'WhatsApp Customer' }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-pabbas-ai-secret",
              "value": "={{ $env.PABBAS_AI_WEBHOOK_SECRET }}"
            }
          ]
        },
        "options": {
          "timeout": 20000,
          "ignoreHttpStatusCodes": false
        }
      },
      "id": "pabbas-abandoned-cart-resolve-secure-session",
      "name": "Resolve Secure Customer Session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1530,
        200
      ],
      "alwaysOutputData": true,
      "onError": "stopWorkflow"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "JavaScript",
        "jsCode": "const rs = (n) => 'Rs ' + Number(n || 0).toLocaleString('en-IN'); const input = $input.first().json || {}; const c = input.cart || {}; const phone = input.phone || c.phone || ''; const ctaUrl = input.cta_url || input.ctaUrl || ''; if (!phone) return [{ json: { skip: true, reason: 'missing_cart_phone', phone } }]; if (!ctaUrl) return [{ json: { skip: true, reason: 'missing_cta_url', phone } }]; const items = Array.isArray(c.items) ? c.items : []; const names = items.slice(0, 3).map((i) => i.name).join(', '); const more = items.length > 3 ? ' and ' + (items.length - 3) + ' more' : ''; const message = 'You left ' + (names || 'a few items') + more + ' in your cart (' + rs(c.total) + ').\n\nStill hungry? Tap below and we will get it moving.'; return [{ json: { skip: false, phone, cta_url: ctaUrl, outgoing: { type: 'interactive', interactive: { type: 'cta_url', body: { text: message }, action: { name: 'cta_url', parameters: { display_text: 'Finish Order', url: ctaUrl } } } } }];"
      },
      "id": "pabbas-abandoned-cart-build-nudge",
      "name": "Build Nudge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1750,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.skip }}",
              "operation": "false"
            }
          ]
        }
      },
      "id": "pabbas-abandoned-cart-cta-valid",
      "name": "CTA Ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1970,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "JavaScript",
        "jsCode": "return $input.all();"
      },
      "id": "pabbas-abandoned-cart-skip-invalid-cta",
      "name": "Skip Invalid CTA",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1970,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ycloud.com/whatsapp/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ to: $json.phone }, $json.outgoing)) }}",
        "options": {
          "timeout": 15000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      },
      "id": "pabbas-abandoned-cart-send-nudge",
      "name": "Send Nudge (TODO: verify YCloud payload)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2190,
        120
      ],
      "disabled": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "Pabbas_YCloud_WhatsApp_Token_ID",
          "name": "Pabbas YCloud WhatsApp Token"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/carts",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "=eq.{{ $json.phone }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ nudged_at: new Date().toISOString() }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "pabbas-abandoned-cart-mark-nudged",
      "name": "Mark Nudged",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2410,
        120
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL || 'https://YOUR_PROJECT_REF.supabase.co' }}/rest/v1/messages",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ phone: $json.phone, direction: 'outbound', sender: 'system', message_type: 'text', content: '[abandoned cart nudge]' }) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "pabbas-abandoned-cart-log-nudge",
      "name": "Log Nudge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2630,
        120
      ],
      "credentials": {
        "httpCustomAuth": {
          "id": "Supabase_Service_Role_ID",
          "name": "Supabase Service Role"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    }
  ],
  "active": false,
  "pinData": {},
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "tags": [],
  "id": "",
  "meta": {},
  "connections": {
    "Every 10 Minutes": {
      "main": [
        [
          {
            "node": "Find Abandoned",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Abandoned": {
      "main": [
        [
          {
            "node": "Loop Carts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Carts": {
      "main": [
        [
          {
            "node": "Resolve Customer Identity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve Customer Identity": {
      "main": [
        [
          {
            "node": "Validate Customer Identity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Customer Identity": {
      "main": [
        [
          {
            "node": "Customer Identity Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Customer Identity Valid?": {
      "main": [
        [
          {
            "node": "Resolve Secure Customer Session",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip Invalid Identity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve Secure Customer Session": {
      "main": [
        [
          {
            "node": "Build Nudge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Nudge": {
      "main": [
        [
          {
            "node": "CTA Ready?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CTA Ready?": {
      "main": [
        [
          {
            "node": "Send Nudge (TODO: verify YCloud payload)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip Invalid CTA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Nudge (TODO: verify YCloud payload)": {
      "main": [
        [
          {
            "node": "Mark Nudged",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark Nudged": {
      "main": [
        [
          {
            "node": "Log Nudge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
