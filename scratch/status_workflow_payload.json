    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst body = item.json.body || item.json;\n\nconst order_number = body.order_number || '';\nconst customer_phone = body.customer_phone || '';\nconst customer_name = body.customer_name || 'Valued Customer';\nconst order_type = body.order_type || 'delivery';\nconst items = body.items || [];\nconst total = body.total || 0;\n\nreturn [{\n  json: {\n    order_number,\n    customer_phone,\n    customer_name,\n    order_type,\n    items,\n    total\n  }\n}];"
      },
      "id": "521285bc-cc5d-435e-adfe-513f2d14ce92",
      "name": "Extract Order Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst o = item.json;\n\nlet itemLines = '';\nif (Array.isArray(o.items) && o.items.length > 0) {\n  itemLines = o.items\n    .map(i => `• ${i.item_name} x${i.quantity}`)\n    .join('\\n');\n} else {\n  itemLines = '• (see order details)';\n}\n\nconst typeLabel = o.order_type === 'dine-in' ? 'Dine-in' :\n                  o.order_type === 'takeaway' ? 'Takeaway' : 'Delivery';\n\nconst msg = `Hi ${o.customer_name}! 👋\n\nWe've received your Pabbas ${typeLabel} order #${o.order_number}.\n\nYour order:\n${itemLines}\n\nTotal: ₹${o.total}\n\nWe'll keep you updated here on WhatsApp. Thank you!`;\n\nreturn [{\n  json: {\n    phone: o.customer_phone,\n    message: msg,\n    skip: !o.customer_phone\n  }\n}];"
      },
